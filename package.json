{
  "name": "wordcraft",
  "version": "0.1.0",
  "description": "Procesador de textos ligero",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.miuu.wordcraft",
    "productName": "WordCraft",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ]
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-color": "^3.35.0",
    "@tiptap/extension-font-family": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-table-cell": "^3.35.0",
    "@tiptap/extension-table-header": "^3.35.0",
    "@tiptap/extension-table-row": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "docx": "^9.16.0",
    "lowlight": "^3.3.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^25.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
